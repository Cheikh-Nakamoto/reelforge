{
  "title": "studio style",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "fonts": {
      "default": {},
      "type": "object",
      "properties": {
        "caption": {
          "default": "Montserrat",
          "type": "string"
        },
        "captionWeight": {
          "default": 800,
          "type": "number"
        },
        "behind": {
          "default": "League Gothic",
          "type": "string"
        },
        "behindWeight": {
          "default": 400,
          "type": "number"
        },
        "graphic": {
          "default": "Inter",
          "type": "string"
        }
      }
    },
    "colors": {
      "default": {},
      "type": "object",
      "properties": {
        "text": {
          "default": "#ffffff",
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{3,8}|rgba?\\(.+\\))$"
        },
        "accent": {
          "default": "#ffd400",
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{3,8}|rgba?\\(.+\\))$"
        },
        "stroke": {
          "default": "rgba(0,0,0,0.55)",
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{3,8}|rgba?\\(.+\\))$"
        },
        "behind": {
          "default": "#ffffff",
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{3,8}|rgba?\\(.+\\))$"
        },
        "panel": {
          "default": "rgba(10,10,10,0.78)",
          "type": "string",
          "pattern": "^(#[0-9a-fA-F]{3,8}|rgba?\\(.+\\))$"
        }
      }
    },
    "rhythm": {
      "default": {},
      "type": "object",
      "properties": {
        "silenceDb": {
          "default": "auto",
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "number"
            }
          ]
        },
        "minPause": {
          "default": 0.35,
          "type": "number"
        },
        "keep": {
          "default": 0.12,
          "type": "number"
        },
        "removeFillers": {
          "default": true,
          "type": "boolean"
        },
        "removeRetakes": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "captions": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "maxWords": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxChars": {
          "default": 18,
          "type": "integer",
          "minimum": 6,
          "maximum": 9007199254740991
        },
        "breakPause": {
          "default": 0.15,
          "type": "number"
        },
        "uppercase": {
          "default": false,
          "type": "boolean"
        },
        "look": {
          "default": "bold",
          "type": "string",
          "enum": [
            "bold",
            "pill",
            "editorial",
            "minimal"
          ]
        },
        "animation": {
          "default": "pop",
          "type": "string",
          "enum": [
            "pop",
            "rise",
            "karaoke",
            "slam"
          ]
        },
        "size": {
          "default": 80,
          "type": "number"
        },
        "stack": {
          "default": true,
          "type": "boolean"
        },
        "keyFont": {
          "type": "string"
        },
        "keyItalic": {
          "default": false,
          "type": "boolean"
        },
        "highlightActive": {
          "default": true,
          "type": "boolean"
        },
        "box": {
          "default": false,
          "type": "boolean"
        },
        "position": {
          "default": "low",
          "type": "string",
          "enum": [
            "low",
            "mid"
          ]
        },
        "emphasis": {
          "default": 1.3,
          "type": "number",
          "minimum": 1,
          "maximum": 1.8
        },
        "emojis": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "behind": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "hold": {
          "default": 1.6,
          "type": "number"
        },
        "minGap": {
          "default": 5,
          "type": "number"
        },
        "animation": {
          "default": "slam",
          "type": "string",
          "enum": [
            "slam",
            "rise",
            "track",
            "flip"
          ]
        },
        "size": {
          "default": 0.34,
          "type": "number"
        },
        "hideCaptions": {
          "default": false,
          "type": "boolean"
        },
        "coverage": {
          "default": 0.4,
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.7
        }
      }
    },
    "mograph": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "minGap": {
          "default": 3,
          "type": "number"
        },
        "triggers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "words": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "callout",
                  "underline",
                  "badge",
                  "list"
                ]
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "words",
              "kind"
            ]
          }
        },
        "numbers": {
          "default": true,
          "type": "boolean"
        },
        "contextual": {
          "default": true,
          "type": "boolean"
        },
        "hook": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "motion": {
      "default": {},
      "type": "object",
      "properties": {
        "punchIn": {
          "default": 1.06,
          "type": "number",
          "minimum": 1,
          "maximum": 1.3
        },
        "jumpZoom": {
          "default": 1,
          "type": "number",
          "minimum": 1,
          "maximum": 1.3
        },
        "depth": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blur": {
          "default": false,
          "type": "boolean"
        },
        "drift": {
          "default": 1,
          "type": "number",
          "minimum": 1,
          "maximum": 1.12
        },
        "ease": {
          "default": "power3.out",
          "type": "string"
        }
      }
    },
    "scenes": {
      "default": {},
      "type": "object",
      "properties": {
        "max": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "minGap": {
          "default": 8,
          "type": "number"
        },
        "background": {
          "default": "gradient",
          "type": "string",
          "enum": [
            "gradient",
            "dark"
          ]
        }
      }
    },
    "frame": {
      "default": {},
      "type": "object",
      "properties": {
        "reduceOn": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "mographs"
          ]
        },
        "cardScale": {
          "default": 0.74,
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.95
        },
        "bubbleScale": {
          "default": 0.36,
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.5
        },
        "radius": {
          "default": 44,
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "device": {
          "default": false,
          "type": "boolean"
        },
        "stage": {
          "default": "#0d1117",
          "type": "string"
        }
      }
    },
    "effects": {
      "default": {},
      "type": "object",
      "properties": {
        "maxPer10s": {
          "default": 2,
          "type": "number",
          "minimum": 0,
          "maximum": 6
        },
        "strongWord": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "zoomPunch",
            "shake",
            "both"
          ]
        },
        "cuts": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "flash",
            "whip",
            "glitch",
            "mix"
          ]
        },
        "cutEvery": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "lightLeaks": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "colorPop": {
          "default": false,
          "type": "boolean"
        },
        "rgbSplit": {
          "default": false,
          "type": "boolean"
        },
        "ladder": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "keywords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "words": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "shake",
                  "zoomPunch",
                  "flash",
                  "glitch",
                  "rgbSplit",
                  "strobe"
                ]
              }
            },
            "required": [
              "words",
              "kind"
            ]
          }
        },
        "intensity": {
          "default": 1,
          "type": "number",
          "minimum": 0.2,
          "maximum": 2
        }
      }
    },
    "look": {
      "default": {},
      "type": "object",
      "properties": {
        "grade": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "deep-contrast",
            "clean-studio",
            "bright-pop",
            "muted-editorial",
            "warm-daylight",
            "mono-clean"
          ]
        },
        "gradeIntensity": {
          "default": 0.8,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vignette": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grain": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "letterbox": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "audio": {
      "default": {},
      "type": "object",
      "properties": {
        "denoise": {
          "default": true,
          "type": "boolean"
        },
        "lufs": {
          "default": -16,
          "type": "number"
        },
        "music": {
          "default": "auto",
          "type": "string"
        },
        "musicDb": {
          "default": -22,
          "type": "number"
        },
        "duckDb": {
          "default": 10,
          "type": "number"
        },
        "sfx": {
          "default": true,
          "type": "boolean"
        },
        "sfxDb": {
          "default": -14,
          "type": "number"
        }
      }
    }
  },
  "required": [
    "name"
  ]
}
